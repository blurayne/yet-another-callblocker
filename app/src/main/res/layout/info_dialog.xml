<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- what is known about the number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                tools:text="Contact name" />

            <TextView
                android:id="@+id/featured_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                tools:text="Featured company name" />

            <TextView
                android:id="@+id/category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp"
                tools:text="Category" />

            <include
                layout="@layout/reviews_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/blacklist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                tools:text="Blacklist name" />

            <!-- the lists the number is on, one line each -->
            <TextView
                android:id="@+id/whitelisted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/info_whitelisted"
                android:textColor="@color/ratePositive"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/in_blacklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/info_in_blacklist"
                android:textColor="@color/rateNegative"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/phone_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:textSize="14sp"
                tools:text="PhoneBlock: advertising" />

            <TextView
                android:id="@+id/call_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="Called: 29 Aug 2026, 11:38:42" />

        </LinearLayout>

        <View
            android:id="@+id/actions_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- what can be done with it; each row is shown when it applies -->
        <include
            android:id="@+id/action_whitelist"
            layout="@layout/info_dialog_action" />

        <include
            android:id="@+id/action_blacklist"
            layout="@layout/info_dialog_action" />

        <include
            android:id="@+id/action_contacts"
            layout="@layout/info_dialog_action" />

        <include
            android:id="@+id/action_phone_block"
            layout="@layout/info_dialog_action" />

        <include
            android:id="@+id/action_reviews"
            layout="@layout/info_dialog_action" />

        <include
            android:id="@+id/action_web_review"
            layout="@layout/info_dialog_action" />

    </LinearLayout>

</ScrollView>
